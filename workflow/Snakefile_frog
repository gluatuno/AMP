# ===========================================================================
# Frog AMP -> genome training-set pipeline (initial project)
#   snakemake -s workflow/Snakefile_frog --use-conda --cores 8
# ===========================================================================
# Collect frog AMPs (APD3) -> route each to its genomed source species ->
# map to that genome -> extract gene locus + features -> build a labelled
# matrix (AMP loci = positives) -> train a baseline AMP genome model.
#
# Only species with a genome are mapped (see config/frog_species.tsv); AMPs
# from genome-less genera are reported in assignments.tsv and set aside.
# ===========================================================================

configfile: "config/frog.yaml"

OUT = config["outdir"]
RES = config["resources_dir"]


def genomed_species():
    """Species with has_genome in {yes,partial}, as safe dir names."""
    out = {}
    with open(config["species_table"]) as fh:
        for line in fh:
            if not line.strip() or line.startswith("#"):
                continue
            f = line.rstrip("\n").split("\t")
            if len(f) >= 7 and f[5].lower() in ("yes", "partial"):
                out[f[0].replace(" ", "_")] = {"species": f[0], "acc": f[3]}
    return out


SPECIES = genomed_species()


rule all:
    input:
        OUT + "/amp/assignments.tsv",
        OUT + "/model/metrics.tsv",
        OUT + "/model/feature_matrix.tsv",

include: "rules/frog.smk"
